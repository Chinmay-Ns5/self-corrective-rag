# External API keys
TAVILY_API_KEY=

# Local Ollama model and endpoint
# Use an installed model from `ollama list`, or pull llama3.2 first.
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://127.0.0.1:11434/api/chat

# Initial routing thresholds; tune on a labeled validation set
CRAG_LOW_THRESHOLD=0.40
CRAG_HIGH_THRESHOLD=0.75
CRAG_TOP_K=5
